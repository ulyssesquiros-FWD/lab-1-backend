{
	"info": {
		"_postman_id": "c7a8b412-32a1-4034-9d5f-e58f0cb18a42",
		"name": "Practica Backend - APIs",
		"description": "Colección de pruebas para la Práctica 1 de Desarrollo Back End: Postman, Colecciones y Consumo de APIs REST (API Local y API Pública).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
